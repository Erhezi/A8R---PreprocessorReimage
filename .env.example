# Contract Atlas — Preprocessor EC
# Copy this file to .env and fill in real values.

# OpenAI / LLM config
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna
OPENAI_DISABLE_SSL_VERIFY=false
OPENAI_USE_SYSTEM_CA_STORE=true
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.0

# Optional: point the app at a custom OpenAI-compatible gateway.
# Include the /v1 path if your gateway expects it.
# OPENAI_BASE_URL=https://your-gateway.example.com/v1
# OPENAI_TIMEOUT_SECONDS=30
# OPENAI_MAX_RETRIES=2
# OPENAI_DISABLE_SSL_VERIFY=false
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=

# Optional: Azure OpenAI.
# When AZURE_OPENAI_ENDPOINT is set, the app uses AzureOpenAI instead of OpenAI.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21

# Flask (optional overrides)
# SECRET_KEY=change-me-in-production
# URL_PREFIX=/preprocessor
